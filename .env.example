APP_NAME="R-Square Construction"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- MySQL (create the database + user in cPanel > MySQL Databases) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_rsquare
DB_USERNAME=cpaneluser_rsquare
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- Public uploads ---
# Leave these unset: the deploy script links public_html/storage to storage/app/public.
# Only if your host blocks symlinks, point the public disk straight at a folder inside public_html:
# PUBLIC_DISK_ROOT=/home/cpaneluser/public_html/storage
# PUBLIC_DISK_URL=https://www.your-domain.com/storage

# --- Email (cPanel > Email Accounts > Connect Devices shows these values) ---
MAIL_MAILER=smtp
MAIL_HOST=mail.your-domain.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=info@your-domain.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"
# Extra comma-separated recipients for new message / quote notifications (optional).
NOTIFY_EMAILS=

# --- First administrator, created by `php artisan db:seed --force` ---
# Remove ADMIN_PASSWORD from this file after the first login.
# Or skip these and run: php artisan admin:create
ADMIN_NAME="Site Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
